<% if (theme.leancloud && theme.leancloud.app_id && theme.leancloud.app_key) { %>
<% var leancloud = theme.leancloud; %>
<script src="<%- leancloud.cdn || '//cdn1.lncld.net/static/js/3.1.1/av-min.js' %>"></script>
<script id="leancloud">
  AV.init({
    appId: "<%- leancloud.app_id %>",
    appKey: "<%- leancloud.app_key %>"<% if (leancloud.server_url) { %>,
    serverURL: "<%- leancloud.server_url %>"<% } %>
  });
</script>
<% } %>
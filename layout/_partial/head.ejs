<!-- Website mata -->
<%- partial ("./_head/meta.ejs") %>

<!-- Website rss -->
<% if (theme.rss === 'default') { %>
<%- feed_tag(config.feed && config.feed.path ? config.feed.path : 'atom.xml') %>
<% } else if (theme.rss) { %>
<%- feed_tag(theme.rss) %>
<% } %>

<!-- Website favicon -->
<% if (theme.favicon) { %>
<link rel="shortcut icon" type="image/x-icon" href="<%- url_for(theme.favicon) %>?v=<%- theme.version %>" />
<% } %>

<!-- Canonical, good for google search engine -->
<link rel="canonical" href="<%- config.url %>/<%- page.canonical_path.replace('index.html', '') %>" />

<!-- Fancybox styling -->
<% if (theme.fancybox) { %>
<link rel="stylesheet" type="text/css" href="<%- url_for('lib/fancybox/jquery.fancybox.css') %>" />
<% } %>

<!-- LaTeX support: renderer is selectable via theme.latex_renderer -->
<% var latexRenderer = theme.latex_renderer || ((theme.katex && theme.katex.enable) ? 'katex' : 'mathjax'); %>
<% var useKatex = latexRenderer === 'katex' && theme.katex && theme.katex.enable; %>
<% if (theme.latex && useKatex) { %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous"></script>
<% if (theme.katex.autoRender) { %>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js" crossorigin="anonymous"
  onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true},{left: '$', right: '$', display: false},{left: '\\[', right: '\\]', display: true}]});"></script>
<% } %>
<% } else if (theme.latex) { %>
<!-- MathJax (LaTeX) support -->
<script type="text/x-mathjax-config">
  MathJax.Hub.Config({ tex2jax: { inlineMath: [['$','$'], ['\\(','\\)']] } });  
  </script>
<script type="text/javascript" async src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.5/MathJax.js?config=TeX-MML-AM_CHTML"></script>
<% } %>

<!-- Mermaid diagram support: mermaid v11 injects its own styles at runtime,
     and the package ships no standalone stylesheet -->

<!-- Theme styling -->
<link rel="stylesheet" type="text/css" href="<%- url_for('css/style.css') %>?v=<%- theme.version %>" />

<!-- Analytics and push -->
<% if (!env.debug) { %>
<%- partial ("../_script/analytics.ejs") %>
<%- partial ("../_script/push.ejs") %>
<% } %>

<!-- LeanCloud Counter -->
<%- partial ("../_script/counter.ejs") %>
<% var themeConfig = { leancloud: theme.leancloud, toc: theme.toc, fancybox: theme.fancybox, latex: theme.latex, latex_renderer: useKatex ? 'katex' : 'mathjax', katex: theme.katex, mermaid: theme.mermaid }; %>
<script>
  window.config = <%- JSON.stringify(themeConfig) %>;
</script>